# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real values never get committed, but the template does
.env*
!.env.example

# GCP service account keys must never be committed. Prefer Application
# Default Credentials (gcloud auth application-default login) locally.
*-key.json
gcp-key.json
service-account*.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Locally-generated placeholder fusion images (FUSGUESSR_FAKE_IMAGE_PIPELINE)
/public/generated

# Prisma generated folder
/prisma/generated