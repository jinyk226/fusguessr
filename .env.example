# Copy to `.env` for local development. Never commit real values.
# Production values live in GCP Secret Manager - see README.md section
# "Deploying to Cloud Run".

# --- Database -------------------------------------------------------------
# Local: plain TCP against the docker-compose Postgres.
# Production: Cloud SQL UNIX SOCKET form, which looks nothing like this:
#   postgresql://USER:PASS@localhost/fusguessr?host=/cloudsql/PROJECT:REGION:INSTANCE&connection_limit=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fusguessr"
# Only used by the integration test suite. MUST contain "test" - the suite
# truncates every table and refuses to run against a URL without it.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fusguessr_test"

# --- Auth.js v5 -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# From the Google Cloud console OAuth client. The AUTH_GOOGLE_* names are
# auto-discovered by Auth.js v5 - renaming them means wiring the provider by hand.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Required in production only. Cloud Run terminates TLS at a proxy and Auth.js
# will throw UntrustedHost without this. Leave unset locally.
# AUTH_TRUST_HOST="true"

# --- Admin ----------------------------------------------------------------
# Comma-separated. On first sign-in a matching email is promoted to ADMIN in
# the database; the DB role is authoritative from then on.
ADMIN_EMAILS=""

# --- Daily rollover cron --------------------------------------------------
# Shared secret checked by GET /api/cron/rollover, in addition to the OIDC
# identity Cloud Scheduler presents in production.
CRON_SECRET=""

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=""
# Imagen model availability is region-specific; verify before changing.
VERTEX_LOCATION="us-central1"
GCS_BUCKET=""

# Local only, and only if Application Default Credentials are impractical.
# NEVER set this on Cloud Run - the attached service account provides ADC.
# GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"

# Set to "1" to skip real Vertex AI/GCS calls and write a local placeholder
# image instead. Lets the admin flow be exercised without spending money.
FUSGUESSR_FAKE_IMAGE_PIPELINE="1"

# --- App ------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined at BUILD time. In production it must be passed as a
# docker build --build-arg, not just as a Cloud Run runtime variable.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
